# Ejemplo de secretos de la app (Streamlit los lee de .streamlit/secrets.toml).
# Copien este archivo a .streamlit/secrets.toml y pongan sus propias claves.
# secrets.toml está en .gitignore: NUNCA se sube al repositorio ni se envía por correo.
# En Streamlit Cloud se pegan en Settings → Secrets de la app.

# Tasas soberanas (FRED). Clave gratuita en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY = "su-clave-de-fred"

# Noticias (Alpha Vantage, opcional). Clave gratuita en https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY = "su-clave-de-alpha-vantage"

# Login OIDC (opcional; solo si DEV_MODE = False en app.py). Formato de st.login de Streamlit.
# [auth]
# redirect_uri = "https://<su-app>.streamlit.app/oauth2callback"
# cookie_secret = "una-cadena-aleatoria-larga"
#
# [auth.google]
# client_id = "xxxx.apps.googleusercontent.com"
# client_secret = "xxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
