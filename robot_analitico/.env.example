# Variables de entorno de ejemplo (sin valores reales). La app de Streamlit lee sus claves de
# .streamlit/secrets.toml (ver .streamlit/secrets.toml.example); este archivo documenta los
# mismos nombres para quien prefiera exportarlas o configurarlas en otro despliegue.
# No suban un .env con valores reales: está en .gitignore.

FRED_API_KEY=su-clave-de-fred
ALPHA_VANTAGE_API_KEY=su-clave-de-alpha-vantage
